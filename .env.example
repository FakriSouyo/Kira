# Semua key di bawah juga bisa ditaruh di ~/.finharness/.credentials.json (prioritas tetap env menang).
# Contoh: { "sectors_api": { "key": "..." }, "llm": { "agent": { "api_key": "..." }, "router": { "api_key": "..." } } }
# Lihat README "Kredensial terpisah" — config.json hanya non-secret.
# Di REPL bisa set langsung: /auth-set SECTORS=... LLM.AGENT=... LLM.ROUTER=... (menulis file mode 0600).

# Sectors API
SECTORS_API_KEY=

# LLM — Tier 1 (agent berat: Bull / Judge)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
# LLM — Tier 2 (Intent Router)
LLM_ROUTER_PROVIDER=openai
LLM_ROUTER_MODEL=gpt-4o-mini

# Anthropic (opsional, jika provider = anthropic)
ANTHROPIC_API_KEY=

# Custom API provider / endpoint (berlaku untuk KEDUA tier, opsional).
# Biarkan kosong untuk memakai endpoint default provider (OpenAI/Anthropic).
# Contoh OpenAI-compatible:
#   DeepSeek    LLM_PROVIDER=openai LLM_BASE_URL=https://api.deepseek.com/v1 LLM_API_KEY=sk-... LLM_MODEL=deepseek-chat
#   OpenRouter  LLM_PROVIDER=openai LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_API_KEY=sk-or-...
#   Ollama lokal LLM_PROVIDER=openai LLM_BASE_URL=http://localhost:11434/v1 LLM_API_KEY=ollama
# (alternatif per-tier: field base_url / api_key di config.json)
# LLM_BASE_URL=
# LLM_API_KEY=

# Override direktori data (~/.finharness secara default)
# FINHARNESS_HOME=

# Development flags
# FINHARNESS_MOCK_SECTORS=true   # data fiks Sectors API (offline)
# FINHARNESS_MOCK_LLM=true       # LLM deterministik (offline, tanpa API key)
# FINHARNESS_DEBUG=true
