# Sectors API
SECTORS_API_KEY=

# LLM — Tier 1 (agent berat: Bull / Judge)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
# LLM — Tier 2 (Intent Router)
LLM_ROUTER_PROVIDER=openai
LLM_ROUTER_MODEL=gpt-4o-mini

# Anthropic (opsional, jika provider = anthropic)
ANTHROPIC_API_KEY=

# Override direktori data (~/.finharness secara default)
# FINHARNESS_HOME=

# Development flags
# FINHARNESS_MOCK_SECTORS=true   # data fiks Sectors API (offline)
# FINHARNESS_MOCK_LLM=true       # LLM deterministik (offline, tanpa API key)
# FINHARNESS_DEBUG=true
