{
  "$schema": "https://unpkg.com/oxlint@1/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-control-regex": "off"
  },
  "overrides": [
    {
      "files": ["apps/**/test/**/*.ts", "packages/**/test/**/*.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
