{
  "name": "finharness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "finharness": "tsx apps/cli/src/index.ts",
    "cli": "tsx apps/cli/src/index.ts",
    "db:migrate": "tsx apps/cli/src/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint apps packages vitest.config.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
